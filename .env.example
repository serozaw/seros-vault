# ── Stripe ────────────────────────────────────────────────────────────────
# From https://dashboard.stripe.com/apikeys (use test keys until you're ready to go live)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# From the webhook endpoint you create at https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Site ──────────────────────────────────────────────────────────────────
# Your deployed URL, no trailing slash. Used to build Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (orders + booking calendar) ────────────────────────────────────
# From https://supabase.com project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key — server-only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Note: preset files live in Vercel Blob, but the app doesn't need a Blob
# token at runtime — it just fetches the URL you paste into lib/presets.ts.
# You only touch Blob directly when uploading a new preset pack via the
# Vercel CLI (`vercel blob put`), which handles its own auth.

# ── Resend (transactional email: receipts + download links) ────────────────
# From https://resend.com/api-keys
RESEND_API_KEY=re_...
# Must be a domain you've verified in Resend, e.g. orders@serosvault.com
EMAIL_FROM="Sero's Vault <orders@yourdomain.com>"
# Where YOU get notified every time a preset or booking sells (your own inbox)
OWNER_EMAIL=you@yourdomain.com
